{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "imagePullSecrets", "secrets", "persistence", "app", "ingress"],
  "properties": {
    "replicaCount": {"type": "integer", "const": 1},
    "image": {
      "type": "object", "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["IfNotPresent", "Always"]}
      }
    },
    "imagePullSecrets": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}
    },
    "secrets": {
      "type": "object", "required": ["existingSecret"],
      "properties": {"existingSecret": {"type": "string", "minLength": 1}}
    },
    "persistence": {
      "type": "object", "required": ["existingClaim"],
      "properties": {"existingClaim": {"type": "string", "minLength": 1}}
    },
    "app": {
      "type": "object", "required": ["eventName", "trustProxyHeaders"],
      "properties": {
        "eventName": {"type": "string", "minLength": 1},
        "trustProxyHeaders": {"enum": ["0", "1"]}
      }
    },
    "ingress": {
      "type": "object", "required": ["className", "host", "tlsMode", "tlsSecretName", "annotations"],
      "properties": {
        "className": {"type": "string", "minLength": 1},
        "host": {"type": "string", "minLength": 1},
        "tlsMode": {"enum": ["secret", "gateway"]},
        "tlsSecretName": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "allOf": [{"if": {"properties": {"tlsMode": {"const": "secret"}}}, "then": {"properties": {"tlsSecretName": {"minLength": 1}}}}]
    }
  }
}
